# Copy to .env and start Langflow with:  langflow run --env-file .env
# Local demo only: lets Directory/Chroma components read ./sample_data and write ./chroma_db.
LANGFLOW_RESTRICT_LOCAL_FILE_ACCESS=false
LANGFLOW_HOST=127.0.0.1
LANGFLOW_PORT=7860
# Single-user local mode (no login screen). Set to false for shared machines.
LANGFLOW_AUTO_LOGIN=true
LANGFLOW_SKIP_AUTH_AUTO_LOGIN=true
DO_NOT_TRACK=true

# Used by scripts/call_api.* (create the key in Langflow: Settings > Langflow API Keys)
LANGFLOW_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=
FLOW_ID=onboarding-rag

# Used by flows/*.py when run with lfx
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text:latest
